# Q22: Write a program to Convert binary to decimal.

binary_str = input("Enter a binary number: ")

decimal_val = 0
power = 0

# Loop through the binary digits from right to left
for digit in reversed(binary_str):
    if digit == '1':
        decimal_val = decimal_val + (2 ** power)
    power = power + 1

print("Decimal equivalent:", decimal_val)