# Q34: Write a program to Print reverse number triangle.
# 12345
# 1234
# 123
# 12
# 1

# Row controls how many numbers to print (starts at 5, goes down to 1)
for i in range(5, 0, -1):
    # Column prints numbers from 1 up to i
    for j in range(1, i + 1):
        print(j, end="")
    print()  # Move to the next line