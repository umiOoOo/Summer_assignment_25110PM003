# Q36: Write a program to Print hollow square pattern.
# *****
# * *
# * *
# * *
# *****

# Loop for 5 rows
for i in range(1, 6):
    # Loop for 5 columns
    for j in range(1, 6):
        # Print a star if it's the first/last row, or first/last column
        if i == 1 or i == 5 or j == 1 or j == 5:
            print("*", end="")
        else:
            # Print a space for the hollow inside
            print(" ", end="")
    print()  # Move to the next line