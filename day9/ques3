# Q35: Write a program to Print repeated character pattern.
# A
# BB
# CCC
# DDDD
# EEEEE

# ASCII value of 'A' is 65, 'B' is 66, etc.
# We loop 5 times for rows 1 to 5
for i in range(1, 6):
    # Find the current character using chr()
    # When i=1, 64+1=65 ('A'). When i=2, 64+2=66 ('B').
    char = chr(64 + i)
    
    # Print the character i times
    for j in range(i):
        print(char, end="")
    print()  # Move to the next line