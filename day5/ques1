# Q17: Write a program to Check perfect number.

# Take input from the user
num = int(input("Enter a number: "))

# Variable to store the sum of factors
divisor_sum = 0

# Loop through all numbers from 1 to num - 1
for i in range(1, num):
    # Check if 'i' is a factor of 'num'
    if num % i == 0:
        divisor_sum += i  # Add the factor to the sum

# Check if the total sum equals the original number
if divisor_sum == num:
    print(f"{num} is a Perfect Number.")
else:
    print(f"{num} is NOT a Perfect Number.")