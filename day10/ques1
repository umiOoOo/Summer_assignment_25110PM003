# Q37: Write a program to Print star pyramid.
# *
# ***
# *****
# *******
# *********

n = 5
for i in range(1, n + 1):
    # Print leading spaces
    for j in range(n - i):
        print(" ", end="")
    # Print stars: (2 * i - 1) stars per row
    for k in range(2 * i - 1):
        print("*", end="")
    # Move to the next line
    print()