# Q40: Write a program to Print character pyramid.
#     A
#    ABA
#   ABCBA
#  ABCDCBA
# ABCDEDCBA

n = 5
for i in range(1, n + 1):
    # Print leading spaces
    for j in range(n - i):
        print(" ", end="")
    
    # Print increasing characters starting from 'A'
    # chr(65) is 'A', chr(66) is 'B', and so on
    for k in range(0, i):
        print(chr(65 + k), end="")
        
    # Print decreasing characters
    for l in range(i - 2, -1, -1):
        print(chr(65 + l), end="")
        
    # Move to the next line
    print()