# Q47: Write a program to Write function for Fibonacci.

def print_fibonacci(terms):
    if terms <= 0:
        print("Please enter a positive integer.")
        return
    
    # Initializing the first two terms
    a, b = 0, 1
    print("Fibonacci Series:")
    
    for _ in range(terms):
        print(a, end=" ")
        # Update values: next term is the sum of previous two
        a, b = b, a + b
    print() # For a new line at the end

# Testing the function
n_terms = int(input("Enter the number of terms for Fibonacci series: "))
print_fibonacci(n_terms)