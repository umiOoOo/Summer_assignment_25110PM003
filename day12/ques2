# Q46: Write a program to Write function for Armstrong.

def is_armstrong(number):
    num_str = str(number)
    num_digits = len(num_str)
    total_sum = 0
    
    # Calculate the sum of digits raised to the power of total digits
    for digit in num_str:
        total_sum += int(digit) ** num_digits
        
    # Check if the sum matches the original number
    if total_sum == number:
        return True
    else:
        return False

# Testing the function
num = int(input("Enter a number to check for Armstrong: "))
if is_armstrong(num):
    print(f"{num} is an Armstrong number.")
else:
    print(f"{num} is not an Armstrong number.")